<script>
    $("#btn_AddUsers").attr("disabled", "disabled");
    $("#txt_Password").attr("disabled", "disabled");

    $("#select_AddUsers").hover(function () {


    });

    $("#select_AddUsers").change(function () {
        $("#btn_AddUsers").removeAttr("disabled");
    });

    $('#checkbox_PasswordNo').click(function () {
        if ($(this).prop("checked") == true) {
            $("#txt_Password").removeAttr("disabled");
        }
        else if ($(this).prop("checked") == false) {

            $("#txt_Password").attr("disabled", "disabled");
        }
    });

    $("#SelectAll").click(function () {
        //$("#selected-item-count").text("0");
        if ($(this).prop("checked") == true) {
            $('.ckb-word-item').each(function () {
                this.checked = true;

            });
        }
        else if ($(this).prop("checked") == false) {
            $('.ckb-word-item').each(function () {
                this.checked = false;

            });
        }


    });

    $("#btn_RemoveList").click(function () {
        var model = new Array();

        var value = $('option:selected', '#select_AddList').val();
        var textBox = $('option:selected', '#select_AddList').text();

        if (textBox !== '') {
            $('#select_AddUsers').append($("<option></option>").attr("value", value).text(textBox));
            $('option:selected', '#select_AddList').remove();
        }


        Itemarry = $('#select_AddUsers > option');

        $.each(Itemarry, function (key, values) {
            var items = {};
            if (values.value !== '') {
                items.UserID = values.value;
                items.UserName = values.text;
                model.push(items);
            }
        });

        $('#select_AddUsers').empty();

        $.ajax({
            url: '/Sharing/SortDropdownListBYCreateaWordListToShare',
            dataType: "json",
            type: "POST",
            contentType: 'application/json; charset=utf-8',
            async: true,
            data: JSON.stringify(model),
            processData: false,
            cache: false,
            success: function (data) {
                $('#select_AddUsers').html('');
                $.each(data, function (key, value) {
                    $('#select_AddUsers').append($("<option></option>").attr("value", value.UserID).text(value.UserName));
                });

            },
            error: function (xhr) {
                alert(xhr);
            }
        });


    });

    function sortList() {

        $('#hfn-index').val(0);
