<script id="review-words-template" type="text/template">
    <tr>
        <td class="td-checkbox-review-words"><input type="checkbox"></td>
        <td><input type="text" class="txt-review-words"></td>
    </tr>
</script>


<script>

    var wordList = [];
    var wordListName = [];

    $(document).on('click', '.tr-word-row', function () {
        var source = $(this);
        var word = $(source).attr('data-word');
        var pronounciation = $(source).attr('data-pronounciation');
        var phrase = $(source).attr('data-phrase');
        var hint = $(source).attr('data-hint');
        var definition = $(source).attr('data-definition');

        $('#div-databaseword').html(word);
        $('#div-Pronounced').html(pronounciation);
        $('#div-Phrase').html(phrase);
        $('#div-Hint').html(hint);
        $('#div-Definition').html(definition);
    });



    $(document).ready(function () {
        var tr = $(document).find('.tr-word-row').first();

        if (tr.length > 0) {
            var word = $(tr).attr('data-word');
            var pronounciation = $(tr).attr('data-pronounciation');
            var phrase = $(tr).attr('data-phrase');
            var hint = $(tr).attr('data-hint');
            var definition = $(tr).attr('data-definition');
            $('#div-databaseword').html(word);
            $('#div-Pronounced').html(pronounciation);
            $('#div-Phrase').html(phrase);
            $('#div-Hint').html(hint);
            $('#div-Definition').html(definition);
        }


    });



    $(document).on('keypress', '.txt-review-words', function (e) {
        alert();
        var key = e.which;
        if (key == 13)  // the enter key code
        {
            var template = $("#review-words-template").html();
            $('#tbody-reviewwords').append(template);
            $('.td-checkbox-review-words').css('pointer-events', 'none');
        }
    });
    var active = true;

    $(".datas123").keypress(function () {
        
        if (active == true) {
            $.ajax({
                type: "POST",
                url: "/Wordutopia/ActivateDatasByID",                                 
                success: function (response) {
                    
                },
                 
                error: function (response) {
                    
                }
            });

            active = false;
        }
        
    })

    $(document).ready(function () {
        $('.td-checkbox-review-words').css('pointer-events', 'none');
    });



    $(document).on('click', '#dpd-show-all-words-reviewwords', function () {
        $.ajax({
            url: '/Wordutopia/refreshReviewWordList',
            type: "POST",
            dataType: 'html',
            success: function (data) {
                
                $('#tbody-reviewwords').html(data);

                wordList = [];
                wordListName = [];


                var tr = $(document).find('.tr-word-row').first();

                if (tr.length > 0) {
                    var word = $(tr).attr('data-word');
                    var pronounciation = $(tr).attr('data-pronounciation');
                    var phrase = $(tr).attr('data-phrase');
                    var hint = $(tr).attr('data-hint');
                    var definition = $(tr).attr('data-definition');
                    $('#div-databaseword').html(word);
                    $('#div-Pronounced').html(pronounciation);
                    $('#div-Phrase').html(phrase);
                    $('#div-Hint').html(hint);
                    $('#div-Definition').html(definition);
                }

            }
        });
    });


</script>


<script>

    $(document).on('click', '#a-create-testformat', function () {
        if (wordList.length == 0) {
            toastrError('Please select a word');
        }
        else {
            var encodedString = btoa(wordList.join(','));
            window.location.href = "/Wordutopia/CreateTest/" + encodedString;
        }
    });



    $(document).on('click', '.ckb-word-item', function () {
        var wordId = $(this).attr('data-wordid');
        var word = $(this).attr('data-word');
        if ($(this).prop("checked") == true) {
            wordList.push(wordId);
            wordListName.push(word);
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
        }
        else {
            wordList.splice($.inArray(wordId, wordList), 1);
            wordListName.splice($.inArray(word, wordListName), 1);
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) - parseInt(1)));
        }
        //console.log(wordList);
    });



    $(document).on('click', '#a-edit-word', function () {
        if (wordList.length == 0) {
            toastrError('Please select a word');
        }
        else if (wordList.length > 1) {
            toastrError('You can only edit one word at a time!');
        }
        else {
            var encodedString = btoa(wordList.join(',') + "-ReviewWords-1");
            window.location.href = "/Wordutopia/EditWord/" + encodedString;
        }
    });


</script>

