<script>
    $(document).on('click', '#a-add-word-fav', function () {
        var cbkStatus = false;
        var wordIds = "";
        var count = 0;
        $(document).find('.ckb-word-item').each(function (index, value) {
            if ($(this).prop("checked") == true) {
                count = count + 1;
                cbkStatus = true;
                if (wordIds == "")
                    wordIds = wordIds + $(this).attr('data-wordid');
                else
                    wordIds = wordIds + "," + $(this).attr('data-wordid');
            }
        });
        if (cbkStatus == false) {
            toastrError('Please select a word');
        }
        else {
            var userId = $('#hfn-userid').val();
            var objs = new Object();
            objs.userId = userId;
            objs.wordIds = wordIds;

            $.ajax({
                url: '/Wordutopia/addfavouriteword',
                type: "POST",
                data: objs,
                dataType: 'JSON',
                success: function (data) {
                    if (data.status) {
                        toastrSuccess("Words added to favourites");
                        setTimeout(function () {
                            location.reload();
                        }, 500);
                    }
                    else {
                        toastrError(data.message);
                    }
                }
            });
        }
    });


    $(document).on('click', '#a-add-word-skiplist', function () {
        var cbkStatus = false;
        var wordIds = "";
        var count = 0;
        $(document).find('.ckb-word-item').each(function (index, value) {
            if ($(this).prop("checked") == true) {
                count = count + 1;
                cbkStatus = true;
                if (wordIds == "")
                    wordIds = wordIds + $(this).attr('data-wordid');
                else
                    wordIds = wordIds + "," + $(this).attr('data-wordid');
            }
        });
        if (cbkStatus == false && wordList.length <= 0) {
            toastrError('Please select a word');
        }
        else {
            var userId = $('#hfn-userid').val();
            var objs = new Object();
            objs.userId = userId;
            //objs.wordIds = wordIds;
            objs.wordIds = wordList.join(',')
            $.ajax({
                url: '/Wordutopia/addskippedword',
                type: "POST",
                data: objs,
                dataType: 'JSON',
                success: function (data) {
                    if (data.status) {
                        toastrSuccess("Words added to skip list");
                        setTimeout(function () {
                            location.reload();
                        }, 500);
                    }
                    else {
                        toastrError(data.message);
                    }
                }
            });
        }
    });


    $("#SelectAll").click(function () {
        $("#selected-item-count").text("0");
        $('.ckb-word-item').each(function () {
            this.checked = true;
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
            var wordId = $(this).attr('data-wordid');
            if ($(this).prop("checked") == true) {
                wordList.push(wordId);
            }
            else {
                wordList.splice($.inArray(wordId, wordList), 1);
            }
        });

    });

</script>

