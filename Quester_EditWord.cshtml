<script>

   

    function Checkshare() {

        var word = $("#wording").val();
        var existword = $("#Existword").val();
        if (word !== "") {
            if (word.trim() !== existword.trim()) {
                $.ajax({
                    url: '/Quester/Quester_Sharecheck?word=' + word,
                    type: "GET",
                    dataType: 'JSON',
                    success: function (data) {
                        if (data > 0) {
                            swal({
                                type: "error",
                                title: "Sorry!",
                                text: "Sorry, that Question already exists in the ONLINE COMMUNITY database.",
                                showCloseButton: true,
                               
                                confirmButtonText: 'Cancel',


                            },
                          function (isConfirm) {
                              window.location.href = "/Quester/Quester_Words";
                          })
                            $("#btnupdate").prop('disabled', true);

                        }
                        else {
                            $("#btnupdate").prop('disabled', false);
                        }
                    }
                });
            }
            else {
                $("#btnupdate").prop('disabled', false);
            }

        }
    }
    $("#chkOnlineshare").change(function () {
        $("#btnupdate").prop('disabled', false);
        if ($(this).prop("checked") == true) {
           
            var word = $("#wording").val();
            if (word !== "") {
                $.ajax({
                    url: '/Quester/Quester_Sharecheck?word=' + word,
                    type: "GET",
                    dataType: 'JSON',
                    success: function (data) {
                        if (data > 0) {

                            swal({
                                type: "error",
                                title: "Sorry!",
                                text: "This word has already been added to your Database.",
                                showCloseButton: true,
                                
                                confirmButtonText: 'Cancel',

                               

                            },
                          function (isConfirm) {
                              window.location.href = "/Quester/Quester_Words";
                          })
                            $("#btnupdate").prop('disabled', true);

                        }
                        else {
                            $("#btnupdate").prop('disabled', false);
                        }
                    }
                });
            }
            chkwordid = 0;
                        
        }
        else {
            $("#btnupdate").prop('disabled', false);
        }
    });

</script>
