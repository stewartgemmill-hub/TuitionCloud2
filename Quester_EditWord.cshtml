        if (data.status) {
            toastrSuccess("Question edited")
            sessionStorage.setItem("Quester_wordId_Edit", data.wordId);
            sessionStorage.setItem("Quester_guid_Edit", data.guid);

            setTimeout(function () {

                var redirectTo = $('#redirectTo').val();
                var mainPanelIndex = $('#mainPanelIndex').val();
                var result = btoa(mainPanelIndex)
                
                window.location.href = "/Quester/Quester_CreateFolder_Edit";

                
            }, 400);
        }
        else {
            $('#error-invalid-details').text(data.message);
            $('#error-invalid-details').show();
        }
    }


