    function Checkshare() {

        var word = $("#wording").val();
        var existword = $("#Existword").val();
        if (word !== "") {
            if (word.trim() !== existword.trim()) {
                $.ajax({
                    url: '/Wordutopia/Sharecheck?word=' + word,
                    type: "GET",
                    dataType: 'JSON',
                    success: function (data) {
                        if (data > 0) {
                            //toastrError("Sorry, that word already exists in the Online Community Database Of Words.");
                            swal({
                                type: "error",
                                title: "Sorry!",
                                text: "Sorry, that word already exists in the ONLINE COMMUNITY database.",
                                showCloseButton: true,
                                // icon: "error",
                                //showCancelButton: true,
                                //showConfirmButton: false,
                                confirmButtonText: 'Cancel',

                                //  confirmButtonColor: "#ff1a1a",

                            },
                          function (isConfirm) {
                              window.location.href = "/Wordutopia/Words";
                          })
                            $("#btnupdate").prop('disabled', true);

                        }
                        else {
                            $("#btnupdate").prop('disabled', false);
                        }
                    }
                });
            }
            else {
                $("#btnupdate").prop('disabled', false);
            }

        }
    }
