@using Newtonsoft;
@model TutionCloudWeb.Model.Quester.Quester_ReverceTests
@{
    Random rnd = new Random();


    if (Model.isNewRandom)
    {
        int r = Model.prevIndex;
        if (Model.index <= 0)
        {
            while ((r == Model.prevIndex) || (r == Model.index))
            {
                r = rnd.Next(1, Convert.ToInt32(Model.totalWordCount));
            }
        }
        else
        {
            if (r == Model.index)
            {
                while ((r == Model.index) || (r == Model.prevIndex))
                {
                    r = rnd.Next(1, Convert.ToInt32(Model.totalWordCount));
                }
            }
            else
            {
                //while ((r == Model.prevIndex) || (r == Model.index))
                //{
                //    r = rnd.Next(1, Convert.ToInt32(Model.totalWordCount));
                //}
            }
        }
        Model.index = r;
    }
    var word = new TutionCloudWeb.Repository.Quester.Quester_WebService_Repository().Quester_getUserWordByRowNumber(Model.userId, Model.index);

    dynamic MyDynamic = new System.Dynamic.ExpandoObject();
    MyDynamic.isNew = true;
    MyDynamic.RandomCrossword = true;
    MyDynamic.crosswordId = Convert.ToInt64(0);
    MyDynamic.wordList = "";
    MyDynamic.completeStatus = false;
    var json = Newtonsoft.Json.JsonConvert.SerializeObject(MyDynamic);
    byte[] byt = System.Text.Encoding.UTF8.GetBytes(json);
    var strModified = Convert.ToBase64String(byt);

}

