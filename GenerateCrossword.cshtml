@model TutionCloudWeb.Models.PostModel.Word.WordClass
@{
    ViewBag.Title = "GenerateCrossword";
    Layout = "~/Views/Shared/_Layout_Wordutopia_Home.cshtml";
    var totalWordCount = Model.totalWordCount;
    //byte[] byt = System.Text.Encoding.UTF8.GetBytes("00");
    //var strModified = Convert.ToBase64String(byt);
    dynamic MyDynamic = new System.Dynamic.ExpandoObject();
    MyDynamic.isNew = true;
    MyDynamic.RandomCrossword = true;
    MyDynamic.crosswordId = Convert.ToInt64(0);
    MyDynamic.wordList = "";
    MyDynamic.completeStatus = false;
    var json = Newtonsoft.Json.JsonConvert.SerializeObject(MyDynamic);
    byte[] byt = System.Text.Encoding.UTF8.GetBytes(json);
    //byte[] byt = System.Text.Encoding.UTF8.GetBytes("00");
    var strModified = Convert.ToBase64String(byt);

}
@Html.HiddenFor(z => z.userId, new { Value = Model.userId })
@Html.HiddenFor(z => z.totalWordCount, new { Value = Model.totalWordCount })
<input type="hidden" id="hfn-index" value="0" />
