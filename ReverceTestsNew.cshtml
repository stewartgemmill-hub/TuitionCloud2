                            //$('#').attr("href", "http://www.google.com/");


                            if (parseInt(obj.index) >= parseInt($('#totalWordCount').val())) {
                                $('#hfn-index').val(parseInt(1));
                            }


                            //11-02-2019
                            //if (parseInt(obj.index) <= parseInt(1)) {
                            //    $('#a-previous-reversetest').css('pointer-events', 'none');
                            //}
                            //else {
                            //    $('#a-previous-reversetest').css('pointer-events', 'auto');
                            //    $('#a-next-reversetest').css('pointer-events', 'auto');
                            //}

                        }
                    });
                }
                else {
                    toastrError(data.message);
                }
            }
        });
    });

