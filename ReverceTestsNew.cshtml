</section>

<script>
    $("#a_ReverceTests").css({ "color": "#98aaff" });
    $(document).on('click', '#a-previous-reversetest', function () {
        var source = $(this);
        var userId = $('#hfn-userId').val();
        var index = $('#hfn-index').val();
        var prevIndex = $('#hfn-prevIndex').val();
        var obj = new Object();
        obj.userId = userId;
        obj.index = parseInt(parseInt(index) - parseInt(1));
        obj.prevIndex = parseInt(index);
        obj.isNewRandom = true;
        obj.totalWordCount = $('#totalWordCount').val();
        $.ajax({
            url: '/Wordutopia/refreshUserReversetestList',
            type: "POST",
            data: obj,
            dataType: 'HTML',
            success: function (data) {
                $('#hfn-index').val(obj.index);
                $('#hfn-prevIndex').val(obj.prevIndex);
                //$('#accordion').html(data);
                $('#div-reversetest').html(data);
                $('#hfn-index').val($('#hfn-toupdate-index').val());
