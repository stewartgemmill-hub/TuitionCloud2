        }
    });


    $(document).on('click', '#delete-all-words', function () {

        if ($('.tr-word-row').length > 0) {
            swal({
                title: "Are you sure?",
                text: "You are about to delete these Question from favourites!",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#004b8d",
                confirmButtonText: "Yes, delete!",
                closeOnConfirm: true
            },
                function (isConfirm) {
                    if (isConfirm) {

                        var userId = $('#userId').val();
                        var objs = new Object();
                        objs.userId = userId;

                        $.ajax({
                            url: '/Quester/Quester_deleteAllFavouriteWords',
                            type: "POST",
                            data: objs,
                            dataType: 'JSON',
