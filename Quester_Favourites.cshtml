                        var objs = new Object();
                        objs.userId = userId;
                        objs.wordIds = wordList.join(',');

                        $.ajax({
                            url: '/Quester/Quester_deletSelectedFavouriteWords',
                            type: "POST",
                            data: objs,
                            dataType: 'JSON',
                            success: function (data) {
                                if (data.status) {
