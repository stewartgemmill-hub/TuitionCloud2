<script>

    $(document).on('click', '.crossword-next , .crossword-prev', function () {
        var current = $(this).attr('data-current');
        $('.' + current).hide();
        var redirect = $(this).attr('data-redirect');
        $('.' + redirect).show();
        //$('.td-' + $(this).attr('data-wordid')).css('background-color', 'green !important');
        var wordid = $('.' + redirect).attr('data-wordid');
        $(document).find('.input-text').css('background-color', 'white');
        $('.td-' + wordid).find('.input-text').focus().css('background-color', 'yellow');
    });


    $(document).ready(function () {
        var wordid = $('.iterate-div1').attr('data-wordid');
        //console.log($('td-' + wordid).find('.input-text'));
        $(document).find('.input-text').css('background-color', 'white');
        $('.td-' + wordid).find('.input-text').focus().css('background-color', 'yellow');


        $(document).find('.checkblock').each(function () {
            //debugger;
            var dataValue = $(this).attr('data-usersetvalue');
            if (dataValue != '' && dataValue != null && dataValue.length == 1) {
                $(this).val(dataValue);
            }
        });


    });






    //$("li").each(function (index) {
    //    console.log(index + ": " + $(this).text());
    //})


    $(document).on('click', '.accordhead-word', function () {
        
        var wordId = $(this).attr('data-wordid');
        var word = $(this).attr('data-word');
        var isVertical = "";
        var isVerticalNew = $('.td-' + wordId).attr('data-isvertical');
        var arr = isVerticalNew.split(',');
        console.log(arr);
        var arraycontains = (arr.indexOf(wordId + "-" + "True") > -1);
        console.log(arraycontains);
        if (arraycontains.toString() == 'true') {
            isVertical = "True";
        }
        else {
            isVertical = "False";
        }
        var xAxis = $('.td-' + wordId).attr('data-xaxis');
        var yAxis = $('.td-' + wordId).attr('data-yaxis');
        var array = word.split("");

        for (var i = 0; i < array.length; i = i + 1) {

            if (isVertical == "True" || isVertical == "true") {
                if (i > 0) {
                    var newXaxis = parseInt(parseInt(xAxis) + parseInt(i));
                    var classname = ".element" + newXaxis + yAxis;
                    $(classname).val(array[i]);
                    $(classname).attr('data-usersetvalue', array[i].toUpperCase());
                }
                else {
                    var classname = ".element" + xAxis + yAxis;
                    $(classname).val(array[i]);
                    $(classname).attr('data-usersetvalue', array[i].toUpperCase());
                }
            }
            else {
                if (i > 0) {
                    var newYaxis = parseInt(parseInt(yAxis) + parseInt(i));
                    var classname = ".element" + xAxis + newYaxis;
                    $(classname).val(array[i]);
                    $(classname).attr('data-usersetvalue', array[i].toUpperCase());
                }
                else {
                    var classname = ".element" + xAxis + yAxis;
                    $(classname).val(array[i]);
                    $(classname).attr('data-usersetvalue', array[i].toUpperCase());
                }
            }

        }


    });

    //basheer on 19/02/2019

    $(document).on('keypress', '.checkblock', function (e) {
        //debugger

        if (e.shiftKey || e.ctrlKey || e.altKey) {
            e.preventDefault();
        } else {
            var key = e.keyCode;
            //if (!((key == 8) || (key == 32) || (key == 46) || (key >= 35 && key <= 40) || (key >= 65 && key <= 90)))
            //if ((key > 64 && key < 91) || (key > 96 && key < 123) || key == 8)
            if (key == 8 || key == 0 || (key > 48 && key < 57) || key == 32 || key == 13) {
                e.preventDefault();
            }
            else {

                //console.log();


                var sourceThis = $(this);
                var value = String.fromCharCode(key);

                //$("#testingid").on('keyup',function(){
                var correctValue = $(this).attr('data-val');
                //$(sourceThis).val($(sourceThis).val());
                if (value.toUpperCase() != atob(correctValue)) {
                    $('#hfn-crossword-complete-status').val('false');
                }
                //alert("basheer");
                var box = $(this).parent();
                var xAxis = $(box).attr('data-xaxis');
                var yAxis = $(box).attr('data-yaxis');
                //document.getElementsByClassName("element" + xAxis + yAxis).value = value;
                //var elem = document.getElementsByClassName("element" + xAxis + yAxis);
                //document.getElementsByClassName("element" + xAxis + yAxis).setAttribute("value", value);

                //for (var k = 0; k < elem.length; k++) {
                //    if (elem[k].hasAttribute("value")) {
                //        alert();
                //        elem.setAttribute("value", value);
                //    }
                //}

                //$(sourceThis).data('usersetvalue', value);
                $(sourceThis).attr('data-usersetvalue', value.toUpperCase());
                //var x = elem.hasAttribute("value");
                //document;
                //var box1 = $(this).closest('.BorderClass');
                //console.log(box);
                //var xAxis1 = $(this).attr('data-xaxis');
                //var yAxis1 = $(this).attr('data-yaxis');

                //testing comments for pushing git
                var word = "";
                var wordId = "0";
                $(document).find('.word-main-div').each(function () {
                    if ($(this).css('display') == 'block') {
                        var iterativeDivSource = $(this);
                        word = $(iterativeDivSource).attr('data-word');
                        wordId = $(iterativeDivSource).attr('data-wordid');
                        //console.log(word);
                        //console.log(wordId);
                    }
                });

                setTimeout(function () {

                    //var isVertical = $('.td-' + wordId).attr('data-isvertical');

                    var isVertical = "";
                    var isVerticalNew = $('.td-' + wordId).attr('data-isvertical');
                    var arr = isVerticalNew.split(',');
                    console.log(arr);
                    var arraycontains = (arr.indexOf(wordId + "-" + "True") > -1);
                    console.log(arraycontains);
                    if (arraycontains.toString() == 'true') {
                        isVertical = "True";
                    }
                    else {
                        isVertical = "False";
                    }


                    var xAxis1 = $('.td-' + wordId).attr('data-xaxis');
                    var yAxis1 = $('.td-' + wordId).attr('data-yaxis');
                    var array = word.split("");
                    var numberarray = [];
                    for (var i = 0; i < array.length; i = i + 1) {

                        if (isVertical == "True" || isVertical == "true") {
                            if (i >= 0) {
                                var newXaxis = parseInt(parseInt(xAxis1) + parseInt(i));
                                var classname = ".element" + newXaxis + yAxis1;
                                numberarray.push(newXaxis + yAxis1);
                            }
                            else {
                                var classname = ".element" + xAxis1 + yAxis1;
                                $(classname).val(array[i]);
                            }
                        }
                        else {
                            if (i >= 0) {
                                var newYaxis = parseInt(parseInt(yAxis) + parseInt(i));
                                var classname = ".element" + xAxis1 + newYaxis;
                                numberarray.push(xAxis1 + newYaxis);
                            }
                            else {
                                var classname = ".element" + xAxis1 + yAxis1;
                                $(classname).val(array[i]);
                            }
                        }

                    }
                    //console.log(numberarray);
                    var axis = xAxis + yAxis;
                    setTimeout(function () {
                        //debugger
                        if ($.inArray(axis, numberarray) != -1) {
