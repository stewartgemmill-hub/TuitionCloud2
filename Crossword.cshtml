    $(document).on('click', '.save-crossword', function () {
        
        var isNew = $('#hfn-crossword-isnew').val();
        var wordlistString = $('#hfn-crossword-wordidlist-string').val();
        var crosswordId = $('#hfn-crossword-id').val();
        //var completeStatus = $('#hfn-crossword-complete-status').val();
        var completeStatus = true;

        $(document).find('.checkblock').each(function () {
            //debugger;
            var dataValue = $(this).val();
            console.log(dataValue);
            var correctValue = $(this).attr('data-val');
            console.log(correctValue);
            if (dataValue.toUpperCase() != atob(correctValue)) {
                completeStatus = false;
                $('#hfn-crossword-complete-status').val(false);
            }
        });

        setTimeout(function () {


            var postObj = new Object();
            postObj.wordIdListString = wordlistString;
            postObj.isNewCrossword = isNew;
            postObj.completeStatus = completeStatus;
            postObj.crosswordId = parseInt(crosswordId);
            postObj.html = btoa($(".Puzzle").html());
            //postObj.html = "dsfsfkishkufhskdsfkh";
            //postObj.html = JSON.stringify($(".Puzzle").html());
            $.ajax({
                url: '/Wordutopia/saveCrosswordToDB',
                type: "POST",
                data: postObj,
                dataType: 'JSON',
                success: function (data) {
                    if (data.status) {
                        toastrSuccess("Crossword Saved");
                        setTimeout(function () {
                            window.location.href = '/Wordutopia/CrosswordArchives/';
                        }, 450);
                    }
                }
            });

        }, 350);
    });




</script>


<script>

    $(document).on('click', '.a-add-word-SkippedList', function () {
        var source = $(this);
        var wordId = $(source).attr('data-wordid');
        var userId = $('#hfn-userId').val();
        var objs = new Object();
        objs.userId = userId;
        objs.wordIds = wordId;
        $.ajax({
            url: '/Wordutopia/addskippedword',
            type: "POST",
            data: objs,
            dataType: 'JSON',
            success: function (data) {
                if (data.status) {
                    toastrSuccess("Word added to skip list");
                    $(source).addClass('a-remove-word-SkippedList').text('Remove From Skipped List');
                    $(source).removeClass('a-add-word-SkippedList');
                    $(document).find('.a-favourite' + wordId).removeClass('a-remove-word-fav');
                    $(document).find('.a-favourite' + wordId).addClass('a-add-word-fav').text('Add To Favourite');
                }
                else {
                    toastrError(data.message);
                }
            }
        });
    });

