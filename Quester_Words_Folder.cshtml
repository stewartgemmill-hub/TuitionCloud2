<script>


    /////tree start................

    var OBJ = new Object();
    var binding_ObJ = [];
    var zNodes = [];
    var setting = {

        data: {
            simpleData: {

                enable: true
            }
        },
        edit: {
            enable: false,
            // showRemoveBtn: setRemoveBtn
        },
        callback: {

            onClick: zTreeOnClick,
            //beforeRemove: zTreeBeforeRemove,
            //onRemove: zTreeOnRemove,
            //onRename: zTreeOnRename


        }
    };



    function zTreeOnClick(event, treeId, treeNode) {
        //debugger;
        var searchText = "";
        
        if (treeNode.isParent == true) {
        
            $.each(zNodes, function (key, items) {
                
         
                if (items.pId == treeNode.id) {
                   
                    if (searchText == "") {
                        searchText = items.tId;
                       
                    }
                    else {
                       
                        searchText = searchText + "," +items.tId;
                    }
                }
                

            });

            if (searchText != "" || searchText != null) {
                
                
                $.ajax({
                    url: '/Quester/Quester_WordCount_Folder?userId=' + parseInt($('#userId').val()) + '&searchText=' + searchText,
                    type: "GET",
                    dataType: 'JSON',
                    success: function (data) {
                        $('#totalWordCount').val(data);
                        var obj = new Object();
                        obj.userId = $('#userId').val();
                        obj.totalWordCount = $('#totalWordCount').val();
                        obj.index = parseInt($('#hfn-index').val());
                        obj.searchText = searchText;
                        obj.sortBy = $('#hfn-sortby').val();
                        obj.sortOrder = $('#hfn-sortorder').val();
                        $.ajax({
                            url: '/Quester/Quester_refreshUserWordList_Folder',
                            type: "POST",
                            data: obj,
                            dataType: 'html',
                            success: function (data) {
                               
                                $('#tbody-wordlist').html(data);
                                var tr = $(document).find('.tr-word-row').first();
                                if (tr.length > 0) {
                                    var word = $(tr).attr('data-word');
                                    var pronounciation = $(tr).attr('data-pronounciation');
                                    var phrase = $(tr).attr('data-phrase');
                                    var hint = $(tr).attr('data-hint');
                                    var definition = $(tr).attr('data-definition');

                                    var CategoryName = $(tr).attr('data-categoryname');
                                    $('#div-CategoryName').html(CategoryName);

                                    $('#div-databaseword').html(word);
                                    $('#div-Pronounced').html(pronounciation);
                                    $('#div-Phrase').html(phrase);
                                    $('#div-Hint').html(hint);
                                    $('#div-Definition').html(definition);
                                }
                                var obj1 = new Object();
                                obj1.userId = $('#userId').val();
                                obj1.totalWordCount = $('#totalWordCount').val();
                                obj1.index = parseInt(parseInt($('#hfn-index').val()) + 1);
                                obj1.searchText = $('#ipt-word-search').val();
                                obj1.sortBy = $('#hfn-sortby').val();
                                obj1.sortOrder = $('#hfn-sortorder').val();
                                $.ajax({
                                    url: '/Quester/Quester_refreshUserWordListPagination_Folder',
                                    type: "POST",
                                    data: obj1,
                                    dataType: 'html',
                                    success: function (data) {
                                        $('#nav-pagination').html(data);
                                        $('#div-page-count').html('<p>Page ' + parseInt(parseInt($('#hfn-index').val()) + 1) + ' of ' + Math.ceil(parseFloat($('#totalWordCount').val()) / parseFloat(10)) + '</p>')
                                    }
                                });
                            }
                        });
                    }
                });



            }
            else {

                $('#tbody-wordlist').html('<tr><td colspan = "4"> No Questions found</td></tr >');

                 $('#nav-pagination').html("");
                $('#div-page-count').html("")


                toastrInfo("No data found");
            }



        }

    };


    


    



    $(document).ready(function () {

        foarmLoad();

        function foarmLoad() {

            $.ajax({
                url: '/Quester/Quester_GetAll_SelectId_Tree',
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    if (data.status == true) {

                        binding_ObJ = JSON.parse(data.message);

                        zNodes = binding_ObJ;

                        var tempBinding_Obj = [];

                        $.each(binding_ObJ, function (key, value) {

                            if (value.isParent == true) {
                                var OBJ = new Object();

                                OBJ.halfCheck = value.halfCheck
                                OBJ.id = value.id
                                OBJ.isAjaxing = value.isAjaxing
                                OBJ.isFirstNode = value.isFirstNode
                                OBJ.isHidden = value.isHidden
                                OBJ.isHover = value.isHover
                                OBJ.isLastNode = value.isLastNode
                                OBJ.isParent = value.isParent
                                OBJ.level = value.level
                                OBJ.name = value.name
                                OBJ.nocheck = value.nocheck
                                OBJ.open = value.open
                                OBJ.pId = value.pId
                                OBJ.parentTId = value.parentTId
                                OBJ.tId = value.tId
                                OBJ.zAsync = value.zAsync

                                tempBinding_Obj.push(OBJ);

                            }


                        });

                        

                        $.fn.zTree.init($("#treeView"), setting, tempBinding_Obj);


                    }
                    else {

                        var zNodesTemp = [{ id: 1, pId: 0, name: "Temp 1", open: true }];

                        $.fn.zTree.init($("#treeView"), setting, zNodesTemp);

                        $("#FolderNotCreated").show();
                        $("#treeView").hide();

                    }


                }
            });

        }



        


    });












    //////////tree end.....................



    $(document).on('click', '#create-test', function () {
        if (wordList.length <= 0) {
            window.location.href = "/Quester/Quester_Exams";
        }
        else {
            var encodedString = btoa(wordList.join(','));
            window.location.href = "/Quester/Quester_CreateTest/" + encodedString;
        }
    });

</script>


<script>

    $('#ipt-word-search').keypress(function (e) {

        var key = e.which;
        if (key == 13)  // the enter key code
        {
            $('#btn-search-word').click();
            //return false;
        }
    });

    $("#SelectAll").click(function () {
        $("#selected-item-count").text("0");

        if ($('.ckb-word-item').prop("checked") == false) {
            $('.ckb-word-item').each(function () {
                this.checked = true;
                $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
                var wordId = $(this).attr('data-wordid');
                if ($(this).prop("checked") == true) {
                    wordList.push(wordId);
                }
                else {
                    wordList.splice($.inArray(wordId, wordList), 1);
                }
            });
        }
        else {
            $('.ckb-word-item').each(function () {
                this.checked = false;
                $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
                var wordId = $(this).attr('data-wordid');
                if ($(this).prop("checked") == false) {
                    wordList.push(wordId);
                }
                else {
                    wordList.splice($.inArray(wordId, wordList), 1);
                }
            });

        }

    });


    $(document).on('click', '.tr-word-row', function () {
        var source = $(this);
        var word = $(source).attr('data-word');
        var pronounciation = $(source).attr('data-pronounciation');
        var phrase = $(source).attr('data-phrase');
        var hint = $(source).attr('data-hint');
        var definition = $(source).attr('data-definition');

        var CategoryName = $(source).attr('data-categoryname');
        $('#div-CategoryName').html(CategoryName);


        $('#div-databaseword').html(word);
        $('#div-Pronounced').html(pronounciation);
        $('#div-Phrase').html(phrase);
        $('#div-Hint').html(hint);
        $('#div-Definition').html(definition);
    });



    $(document).ready(function () {
        var tr = $(document).find('.tr-word-row').first();

        if (tr.length > 0) {
            var word = $(tr).attr('data-word');
            var pronounciation = $(tr).attr('data-pronounciation');
            var phrase = $(tr).attr('data-phrase');
            var hint = $(tr).attr('data-hint');
            var definition = $(tr).attr('data-definition');

            var CategoryName = $(tr).attr('data-categoryname');
            $('#div-CategoryName').html(CategoryName);


            $('#div-databaseword').html(word);
            $('#div-Pronounced').html(pronounciation);
            $('#div-Phrase').html(phrase);
            $('#div-Hint').html(hint);
            $('#div-Definition').html(definition);
        }


    });
    var wordList = [];




    $(document).on('click', '.ckb-word-item', function () {
        var wordId = $(this).attr('data-wordid');
        if ($(this).prop("checked") == true) {
            wordList.push(wordId);
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
        }
        else {
            wordList.splice($.inArray(wordId, wordList), 1);
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) - parseInt(1)));
        }
        console.log(wordList);
    });


</script>

<script>

    $(document).on('click', '.word-delete', function () {
        var source = $(this);
        var wordId = $(this).attr('data-wordid');

        swal({
            title: "Are you sure?",
            text: "Permanently delete this word from your database?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#004b8d",
            confirmButtonText: "Yes, delete!",
            closeOnConfirm: true
        },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        url: '/Quester/Quester_deletWord?wordId=' + wordId,
                        type: "GET",
                        dataType: 'JSON',
                        success: function (data) {
                            if (data.status) {
                                toastrSuccess("Word deleted");

                                $('#totalWordCount').val(parseInt($('#totalWordCount').val() - 1));

                                var islasttr = $(document).find('.tr-word-row');
                                if (islasttr.length <= 1) {
                                    if (parseInt($('#hfn-index').val()) != 0)
                                        $('#hfn-index').val(parseInt($('#hfn-index').val()) - 1)
                                }


                                var obj = new Object();
                                obj.userId = $('#userId').val();
                                obj.totalWordCount = $('#totalWordCount').val();
                                obj.index = parseInt($('#hfn-index').val());
                                obj.searchText = $('#ipt-word-search').val();
                                obj.sortBy = $('#hfn-sortby').val();
                                obj.sortOrder = $('#hfn-sortorder').val();
                                $.ajax({
                                    url: '/Quester/Quester_refreshUserWordList',
                                    type: "POST",
                                    data: obj,
                                    dataType: 'html',
                                    success: function (data) {
                                       
                                        $('#tbody-wordlist').html(data);
                                        var tr = $(document).find('.tr-word-row').first();
                                        if (tr.length > 0) {
                                            var word = $(tr).attr('data-word');
                                            var pronounciation = $(tr).attr('data-pronounciation');
                                            var phrase = $(tr).attr('data-phrase');
                                            var hint = $(tr).attr('data-hint');
                                            var definition = $(tr).attr('data-definition');

                                            var CategoryName = $(tr).attr('data-categoryname');
                                            $('#div-CategoryName').html(CategoryName);

                                            $('#div-databaseword').html(word);
                                            $('#div-Pronounced').html(pronounciation);
                                            $('#div-Phrase').html(phrase);
                                            $('#div-Hint').html(hint);
                                            $('#div-Definition').html(definition);



                                        }
                                        var obj1 = new Object();
                                        obj1.userId = $('#userId').val();
                                        obj1.totalWordCount = $('#totalWordCount').val();
                                        obj1.index = parseInt(parseInt($('#hfn-index').val()) + 1);
                                        obj1.searchText = $('#ipt-word-search').val();
                                        obj1.sortBy = $('#hfn-sortby').val();
                                        obj1.sortOrder = $('#hfn-sortorder').val();
                                        $.ajax({
                                            url: '/Quester/Quester_refreshUserWordListPagination',
                                            type: "POST",
                                            data: obj1,
                                            dataType: 'html',
                                            success: function (data) {
                                                $('#nav-pagination').html(data);
                                                $('#div-page-count').html('<p>Page ' + parseInt(parseInt($('#hfn-index').val()) + 1) + ' of ' + Math.ceil(parseFloat($('#totalWordCount').val()) / parseFloat(10)) + '</p>')
                                            }
                                        });
                                    }
                                });

                            }
                            else {
                                toastrError(data.message);
                            }
                        }
                    });
                }
            });
    });


    $(document).on('click', '#delete-selected-words', function () {
        var cbkStatus = false;
        var wordIds = "";
