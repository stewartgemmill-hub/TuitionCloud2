@model TutionCloudWeb.Models.PostModel.User.Forgotpassword
@{
    ViewBag.Title = "PasswordChange";
    Layout = "~/Views/Shared/_Layout_Index.cshtml";
    var guid = Request.QueryString["id"];
}

<section>
    <div class="container">
        <div class="Loginpg shadowidth">

            <div class="Lg content">
                <div class="content1">

                    <div class="InnerLgrt">
                        <h5>PASSWORD RE-SET</h5>
                        @using (Ajax.BeginForm("passwordchange", "User", null, new AjaxOptions
        {
            HttpMethod = "POST",
            OnSuccess = "passwordchangeSuccess",
            OnFailure = "passwordchangeFailure",
        }, new { id = "tutioncloud-passwordchange" }))
                        {
                             @Html.ValidationSummary(true)
                             @Html.AntiForgeryToken()
                            @Html.HiddenFor(z => z.guid, new { Value = guid })
                            @*<div class="form-group">
                                    <label for="Name">OLD PASSWORD</label>
                                    <input type="email" class="form-control" id="N1" name="name" placeholder="e.g. lorum Ipsum">
                                </div>*@
                            <div class="form-group">
                                <label>NEW PASSWORD *</label>
                                @Html.PasswordFor(m => m.newpassword, new { autocomplete = "off", @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.newpassword)
                            </div>
                            <div class="form-group">
                                <label>CONFIRM NEW-PASSWORD *</label>
                                @Html.PasswordFor(m => m.confirmpassword, new { autocomplete = "off", @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.confirmpassword)
                            </div>
                            <div class="row">
                                <div class=" col-lg-6 form-group">
                                    @*<a href="#" class="Lgbtn btn2">Back To List</a>*@
                                </div>
                                <div class=" col-lg-6 form-group">
                                    @*<a href="#" type="submit" class="Lgbtn btn1">SAVE</a>*@
                                    <button type="submit" style="cursor:pointer;" class="Lgbtn btn1">SAVE</button>
                                </div>
                            </div>
                        }
                        <!--<div class="form-group">
                            <a href="#" class="Fgpwd">Forgot password?</a>
                        </div>-->

                    </div>
                </div>

            </div>
        </div>
    </div>

</section>

<script>

    function passwordchangeSuccess(data) {
        
        if (data.status) {
           
                toastrSuccess("Password updated successfully")
                //swal("Deleted!", "", "success");
           
          
            setTimeout(function () {
                window.location.href = '/User/Login';
            }, 600);
        }
        else {
            toastrError(data.message);
        }
    }

    function passwordchangeFailure(data) {
        
        toastrError(data.message);
    }
  

   
  

</script>

