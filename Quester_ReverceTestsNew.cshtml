@model TutionCloudWeb.Model.Quester.Quester_ReverceTests
@{
    ViewBag.Title = "Quester_ReverseTest";
    Layout = "~/Views/Shared/_Layout_Quester_Home.cshtml";
    var totalWordCount = Model.totalWordCount;
}

<input type="hidden" id="hfn-index" value="@Model.index" />
<input type="hidden" id="hfn-prevIndex" value="@Model.prevIndex" />
@Html.HiddenFor(z => z.totalWordCount, new { Value = Model.totalWordCount })
<input type="hidden" id="hfn-userId" value="@Model.userId" />


<section>
    <div class="container">
        <div class=" upperAccor rev_accr">
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    <h6>Quester - <span class="rev_txt">Reverse Test</span></h6>
                </div>
                <div class="col-lg-5 col-md-5 col-sm-12" id="div-reversetest">
                    @Html.Partial("~/Views/Quester/_pv_Quester_ReverseTest_List_New.cshtml", Model)
                </div>
                <div class="col-lg-3  col-md-3 col-sm-12">

                </div>
            </div>
        </div>

        <div class="lowerNav">
            <nav class="navbar navbar-expand-sm  justify-content-center">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a href="https://en.wikipedia.org/wiki/Main.page" target="_blank">Wikipedia</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.google.com/search?q=calculator" target="_blank">Calculator</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.google.com/maps/" target="_blank">Maps</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.google.com/search?ei=DyM3XNbMEdH6kwW-lpLgCA&q=google+currency+converter&oq=google+currency+converter&gs_l=psy-ab.3..35i39j0i7i30l2j0j0i7i30j0j0i7i30j0l3.211.5629..6378...0.0..0.282.1593.0j6j3......0....1..gws-wiz.......0i71j0i30j0i131i67j35i304i39.BbyIqE0P5UY" target="_blank">Currency Converter</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.timeanddate.com/worldclock/full.html" target="_blank">World Clocks</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://translate.google.com/" target="_blank">Translator</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</section>

<script>
    $("#a_ReverceTests").css({ "color": "#98aaff" });
    $(document).on('click', '#a-previous-reversetest', function () {
        var source = $(this);
        var userId = $('#hfn-userId').val();
        var index = $('#hfn-index').val();
        var prevIndex = $('#hfn-prevIndex').val();
        var obj = new Object();
        obj.userId = userId;
        obj.index = parseInt(parseInt(index) - parseInt(1));
        obj.prevIndex = parseInt(index);
        obj.isNewRandom = true;
        obj.totalWordCount = $('#totalWordCount').val();
        $.ajax({
            url: '/Quester/Quester_refreshUserReversetestList',
            type: "POST",
            data: obj,
            dataType: 'HTML',
            success: function (data) {
                $('#hfn-index').val(obj.index);
                $('#hfn-prevIndex').val(obj.prevIndex);
                
                $('#div-reversetest').html(data);
                $('#hfn-index').val($('#hfn-toupdate-index').val());
                var wordId = $('#hfn-wordid').val();
               
            }
        });
    });

    $(document).on('click', '#a-next-reversetest', function () {
        var source = $(this);
        var userId = $('#hfn-userId').val();
        var index = $('#hfn-index').val();
        var prevIndex = $('#hfn-prevIndex').val();
        var obj = new Object();
        obj.userId = userId;
        obj.index = parseInt(parseInt(index) + parseInt(1));
        obj.prevIndex = parseInt(index);
        obj.isNewRandom = true;
        obj.totalWordCount = $('#totalWordCount').val();
        $.ajax({
            url: '/Quester/Quester_refreshUserReversetestList',
            type: "POST",
            data: obj,
            dataType: 'HTML',
            success: function (data) {
                $('#hfn-index').val(obj.index);
                $('#hfn-prevIndex').val(obj.prevIndex);
                $('#div-reversetest').html(data);
                $('#hfn-index').val($('#hfn-toupdate-index').val());
                
                var wordId = $('#hfn-wordid').val();
                

                if (parseInt(obj.index) >= parseInt($('#totalWordCount').val())) {
                    $('#hfn-index').val(parseInt(1));
                }

                

            }
        });
    });


    $(document).ready(function () {
        var wordId = $('#hfn-wordid').val();
        var index = $('#hfn-index').val();
        $('#hfn-index').val($('#hfn-toupdate-index').val());
        if (parseInt(index) <= 1) {
           
        }
        
    });


    $(document).on('click', '.a-add-word-SkippedList', function () {
        var source = $(this);
        var wordId = $(source).attr('data-wordid');
        var userId = $('#hfn-userId').val();
        var objs = new Object();
        objs.userId = userId;
        objs.wordIds = wordId;
        $.ajax({
            url: '/Quester/Quester_addskippedword',
            type: "POST",
            data: objs,
            dataType: 'JSON',
            success: function (data) {
                if (data.status) {
                    toastrSuccess("Word added to skip list");
                    var index = $('#hfn-index').val();
                    var prevIndex = $('#hfn-prevIndex').val();
                    var obj = new Object();
                    obj.userId = userId;
                    obj.index = parseInt(parseInt(index));
                    obj.prevIndex = parseInt(parseInt(prevIndex));
                    obj.totalWordCount = $('#totalWordCount').val();
                    $.ajax({
                        url: '/Quester/Quester_refreshUserReversetestList',
                        type: "POST",
                        data: obj,
                        dataType: 'HTML',
                        success: function (data) {
                            $('#hfn-index').val(obj.index);
                            $('#hfn-prevIndex').val(obj.prevIndex);
                            
                            $('#div-reversetest').html(data);
                            var wordId = $('#hfn-wordid').val();
                            

                            if (parseInt(obj.index) >= parseInt($('#totalWordCount').val())) {
                                $('#hfn-index').val(parseInt(1));
                            }



                        }
                    });
                }
                else {
                    toastrError(data.message);
                }
            }
        });
    });

    $(document).on('click', '.a-add-word-fav', function () {
        var source = $(this);
        var wordId = $(source).attr('data-wordid');
        var userId = $('#hfn-userId').val();
        var objs = new Object();
        objs.userId = userId;
        objs.wordIds = wordId;
        $.ajax({
            url: '/Quester/Quester_addfavouriteword',
            type: "POST",
            data: objs,
            dataType: 'JSON',
            success: function (data) {
                if (data.status) {
                    toastrSuccess("Word added to favourites");
                    var index = $('#hfn-index').val();
                    var prevIndex = $('#hfn-prevIndex').val();
                    var obj = new Object();
                    obj.userId = userId;
                    obj.index = parseInt(parseInt(index));
                    obj.prevIndex = parseInt(parseInt(prevIndex));
                    obj.totalWordCount = $('#totalWordCount').val();
                    $.ajax({
                        url: '/Quester/Quester_refreshUserReversetestList',
                        type: "POST",
                        data: obj,
                        dataType: 'HTML',
                        success: function (data) {
                            $('#hfn-index').val(obj.index);
                            $('#hfn-prevIndex').val(obj.prevIndex);                            
                            $('#div-reversetest').html(data);
                            var wordId = $('#hfn-wordid').val();
                            
                            if (parseInt(obj.index) >= parseInt($('#totalWordCount').val())) {
                                $('#hfn-index').val(parseInt(1));
                            }

                           
                        }
                    });
                }
                else {
                    toastrError(data.message);
                }
            }
        });
    });

    $(document).on('click', '.a-remove-word-fav', function () {
        var source = $(this);
        var wordId = $(source).attr('data-wordid');
        var userId = $('#hfn-userId').val();
        
        $.ajax({
            url: '/Quester/Quester_deletWordFromFavourites?wordId=' + wordId,
            type: "GET",
            dataType: 'JSON',
            success: function (data) {
                if (data.status) {
                    toastrSuccess("Word removed from favourites");
                    var prevIndex = $('#hfn-prevIndex').val();
                    var index = $('#hfn-index').val();
                    var obj = new Object();
                    obj.userId = userId;
                    obj.index = parseInt(parseInt(index));
                    obj.prevIndex = parseInt(parseInt(prevIndex));
                    obj.totalWordCount = $('#totalWordCount').val();
                    $.ajax({
                        url: '/Quester/Quester_refreshUserReversetestList',
                        type: "POST",
                        data: obj,
                        dataType: 'HTML',
                        success: function (data) {
                            $('#hfn-index').val(obj.index);
                            $('#hfn-prevIndex').val(obj.prevIndex);
                            
                            $('#div-reversetest').html(data);
                            var wordId = $('#hfn-wordid').val();
                            
                            if (parseInt(obj.index) >= parseInt($('#totalWordCount').val())) {
                                $('#hfn-index').val(parseInt(1));
                            }

                        }
                    });
                }
                else {
                    toastrError(data.message);
                }
            }
        });
    });

    $(document).on('click', '.a-remove-word-SkippedList', function () {
        var source = $(this);
        var wordId = $(source).attr('data-wordid');
        var userId = $('#hfn-userId').val();
        
        $.ajax({
            url: '/Quester/Quester_deletWordFromSkipList?wordId=' + wordId,
            type: "GET",
            dataType: 'JSON',
            success: function (data) {
                if (data.status) {
                    toastrSuccess("Word removed from Skip List");
                    var prevIndex = $('#hfn-prevIndex').val();
                    var index = $('#hfn-index').val();
                    var obj = new Object();
                    obj.userId = userId;
                    obj.index = parseInt(parseInt(index));
                    obj.totalWordCount = $('#totalWordCount').val();
                    obj.prevIndex = parseInt(parseInt(prevIndex));
                    $.ajax({
                        url: '/Quester/Quester_refreshUserReversetestList',
                        type: "POST",
                        data: obj,
                        dataType: 'HTML',
                        success: function (data) {
                            $('#hfn-index').val(obj.index);
                            $('#hfn-prevIndex').val(obj.prevIndex);
                            
                            $('#div-reversetest').html(data);
                            var wordId = $('#hfn-wordid').val();
                            

                            if (parseInt(obj.index) >= parseInt($('#totalWordCount').val())) {
                                $('#hfn-index').val(parseInt(1));
                            }

                        }
                    });
                }
                else {
                    toastrError(data.message);
                }
            }
        });
    });

</script>

