            success: function (data) {
                if (data.status == true) {
                    
                    binding_ObJ = [];

                    var tempBinding_Obj = [];

                    binding_ObJ = JSON.parse(data.message);

                    $.each(binding_ObJ, function (key, value) {

                        if (value.isParent == true) {
                            var OBJ = new Object();

                            OBJ.halfCheck = value.halfCheck
                            OBJ.id = value.id
                            OBJ.isAjaxing = value.isAjaxing
                            OBJ.isFirstNode = value.isFirstNode
                            OBJ.isHidden = value.isHidden
                            OBJ.isHover = value.isHover
                            OBJ.isLastNode = value.isLastNode
                            OBJ.isParent = value.isParent
                            OBJ.level = value.level
