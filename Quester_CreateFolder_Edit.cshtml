    function Checkshare() {
        var word = $("#word").val();

        if (word !== "") {
            if ($("#chkOnlineshare").prop('checked') == true) {

                $.ajax({
                    url: '/Quester/Quester_Sharecheck?word=' + word,
                    type: "GET",
                    dataType: 'JSON',
                    success: function (data) {
                        if (data > 0) {
                            swal({
                                type: "error",
                                title: "Sorry!",
                                text: "This word has already been added to your Database.",
                                showCloseButton: true,

                                confirmButtonText: 'Cancel',


                            },
                                function (isConfirm) {
                                    window.location.href = "/Quester/Quester_Words";
                                })


                            $("#btnsave").prop('disabled', true);

                        }
                        else {
                            $("#btnsave").prop('disabled', false);
                        }
                    }
                });
            }

        }
    }

    $("#chkOnlineshare").change(function () {
