<script>

    $(".class_Delete").click(function () {
        //var userId = $(this).attr("Delete-UserId");
        //var deletedate = $(this).attr("Delete-Date-item");
        var obj = Object();
        obj.CreatedOn = $(this).attr("Delete-Date-item");
        obj.userId = $(this).attr("Delete-UserId");
        obj.TestID = $(this).attr("Delete-Test-ID");
        swal({
            title: "Are you sure?",
            text: "Your will not be able to recover this file!",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, delete it!",
            closeOnConfirm: false
        },
           function () {
               $.ajax({
                   url: '/Sharing/ManageSharedTestStats_Delete',
                   type: "GET",
                   data: obj,
                   dataType: 'JSON',
                   success: function (data) {
                       if (data == 1) {
                           //toastrSuccess("Deleted successfully");
                           swal("Deleted!", "Your file has been deleted.", "success");

                       }
                       else {
                           toastrError("Failed");
                       }
                       location.reload();
                   }
               });

           });

    });

</script>