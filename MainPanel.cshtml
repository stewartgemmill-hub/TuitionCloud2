                            <a class="dropdown-item ddl-add-word-fav" href="#">Add To Favourite </a>
                            <a class="dropdown-item" id="ddl-skiplist" href="#">Add To Skipped List</a>
                            <a class="dropdown-item" id="ddl-editword" href="#">Edit Word </a>
                            <a class="dropdown-item" href="#">Find Synonym</a>
                        </div>
                    </div>
                </div>
                <div id="accordion" class="accordion">
                    @Html.Partial("~/Views/Wordutopia/_pv_Wordutopia_Mainpanel_List.cshtml", Model)
