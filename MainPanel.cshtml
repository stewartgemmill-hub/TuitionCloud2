<script>

    $(document).on('click', '#a-previous-mainpanel', function () {
        var source = $(this);
        var userId = $('#hfn-userId').val();
        var index = $('#hfn-index').val();
        var prevIndex = $('#hfn-prevIndex').val(); //13-02-2019
        var obj = new Object();
        obj.userId = userId;

        if (previousWordIndex.length > 0) {
            obj.index = parseInt(previousWordIndex.pop());
            obj.prevIndex = parseInt(prevIndex); //18-02-2019
            obj.isNewRandom = false;
        }
        else {
            obj.index = parseInt(parseInt(index) - parseInt(1));
            obj.prevIndex = parseInt(index); //13-02-2019
            obj.isNewRandom = true;
        }
        obj.totalWordCount = $('#totalWordCount').val();
        $.ajax({
            url: '/Wordutopia/refreshUserMainPanelList',
            type: "POST",
            data: obj,
            dataType: 'HTML',
            success: function (data) {
                //previousWordIndex.splice(-1, 1);
                $('#hfn-index').val(obj.index);
                $('#hfn-prevIndex').val(obj.prevIndex); //13-02-2019
                //$('#accordion').html(data);
                $('#div-mainpanel').html(data);
                $('#hfn-index').val($('#hfn-toupdate-index').val()); //13-02-2019


                var wordId = $('#hfn-wordid').val();
                //$('#ddl-add-word-fav').attr("href", "/Wordutopia/EditWord/" + wordId);
                //var result = btoa(wordId + '-' + 'MainPanel' + '-' + $('#hfn-index').val())
                //$('#ddl-editword').attr("href", "/Wordutopia/EditWord/" + result);
                //$('#').attr("href", "http://www.google.com/");

                //13-02-2019
                //if (parseInt(obj.index) <= parseInt(1)) {
                //    $('#a-previous-mainpanel').css('pointer-events', 'none');
                //}
                //else {
                //    $('#a-previous-mainpanel').css('pointer-events', 'auto');
                //    $('#a-next-mainpanel').css('pointer-events', 'auto');
                //}
                if (previousWordIndex.length <= 0) {
                    $('#a-previous-mainpanel').css('pointer-events', 'none');//13-02-2019
                }
                console.log(previousWordIndex);

            }
        });
    });

    $(document).on('click', '#a-next-mainpanel', function () {
        var source = $(this);
        var userId = $('#hfn-userId').val();
        var index = $('#hfn-index').val();
        var prevIndex = $('#hfn-prevIndex').val(); //13-02-2019
        var randumNumberAdd = $("#randumNumberAdd").val();
        previousWordIndex.push(index);

        var obj = new Object();
        obj.userId = userId;
        obj.index = parseInt(parseInt(index) + parseInt(1));
        obj.prevIndex = parseInt(index); //13-02-2019
        obj.isNewRandom = true;
        if (randumNumberAdd != "") {
            obj.randumNumberAdd = randumNumberAdd;
        }
         
        obj.totalWordCount = $('#totalWordCount').val();
        $.ajax({
            url: '/Wordutopia/refreshUserMainPanelList',
            type: "POST",
            data: obj,
            dataType: 'HTML',
            success: function (data) {
                $('#hfn-index').val(obj.index);
                $('#hfn-prevIndex').val(obj.prevIndex);//13-02-2019
                $('#div-mainpanel').html(data);
                $('#hfn-index').val($('#hfn-toupdate-index').val());//13-02-2019
                //$('#accordion').html(data);
                var wordId = $('#hfn-wordid').val();
                

                if (previousWordIndex.length > 0) {
                    $('#a-previous-mainpanel').css('pointer-events', 'auto');//13-02-2019
                }
                console.log(previousWordIndex);

            }
        });
    });


    $(document).ready(function () {
        var wordId = $('#hfn-wordid').val();
