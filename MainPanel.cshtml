@model TutionCloudWeb.Models.PostModel.MainPanel.WordList
@{
    ViewBag.Title = "MainPanel";
    Layout = "~/Views/Shared/_Layout_Wordutopia_Home.cshtml";
    var totalWordCount = Model.totalWordCount;
}
<input type="hidden" id="hfn-index" value="@Model.index" />
<input type="hidden" id="hfn-prevIndex" value="@Model.prevIndex" />
@Html.HiddenFor(z => z.totalWordCount, new { Value = Model.totalWordCount })
<input type="hidden" id="hfn-userId" value="@Model.userId" />
<section>
    <div class="container">
        <div class="row">

            <div class="main_head">
                <h6>Wordutopia - Mainpanel</h6>
            </div>
        </div>
        <div class="outAccordtn Mainpanel">
            <div class=" upperAccor  wraper">
                <div class="float-left">
                    <div class="innerprv" style="cursor: pointer;">
                        <a id="a-previous-mainpanel" style="color: #ce1414;"><img src="~/Content/img/leftarrow.png" /><span>Previous</span></a>
                    </div>
                </div>
                <div class="float-right">
                    <div class="innernxt" style="cursor: pointer;">
                        <a id="a-next-mainpanel" style="color: #159623;@(Convert.ToInt32(totalWordCount)<=1?"pointer-events: none":"")">Next<span><img src="~/Content/img/rightarrow.png" /></span></a>
                    </div>
                </div>
            </div>
            <div id="div-mainpanel">
                @Html.Partial("~/Views/Wordutopia/_pv_Wordutopia_Mainpanel_List.cshtml", Model)
            </div>
