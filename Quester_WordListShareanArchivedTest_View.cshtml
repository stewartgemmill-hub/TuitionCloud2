<script>

    $(document).on('click', '#create-test', function () {
        if (wordList.length <= 0) {
            window.location.href = "/Quester/Quester_Exams";
        }
        else {
            var encodedString = btoa(wordList.join(','));
            window.location.href = "/Quester/Quester_CreateTest/" + encodedString;
        }
    });

</script>


<script>

    $("#a_ClickSharing").css({ "color": "#98aaff" });
    $('#ipt-word-search').keypress(function (e) {

        var key = e.which;
        if (key == 13)  // the enter key code
        {
            $('#btn-search-word').click();
            //return false;
        }
    });

    $("#SelectAll").click(function () {
        $("#selected-item-count").text("0");

        if ($('.ckb-word-item').prop("checked") == false) {
            $('.ckb-word-item').each(function () {
                this.checked = true;
                $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
                var wordId = $(this).attr('data-wordid');
                if ($(this).prop("checked") == true) {
                    wordList.push(wordId);
                }
                else {
                    wordList.splice($.inArray(wordId, wordList), 1);
                }
            });
        }
        else {
            $('.ckb-word-item').each(function () {
                this.checked = false;
                $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
                var wordId = $(this).attr('data-wordid');
                if ($(this).prop("checked") == false) {
                    wordList.push(wordId);
                }
                else {
                    wordList.splice($.inArray(wordId, wordList), 1);
                }
            });

        }

    });

    //toastrError(data.message);
    $(document).on('click', '.tr-word-row', function () {
        var source = $(this);
        var word = $(source).attr('data-word');
        var pronounciation = $(source).attr('data-pronounciation');
        var phrase = $(source).attr('data-phrase');
        var hint = $(source).attr('data-hint');
        var definition = $(source).attr('data-definition');

        $('#div-databaseword').html(word);
        $('#div-Pronounced').html(pronounciation);
        $('#div-Phrase').html(phrase);
        $('#div-Hint').html(hint);
        $('#div-Definition').html(definition);
    });



    $(document).ready(function () {
        var tr = $(document).find('.tr-word-row').first();

        if (tr.length > 0) {
            var word = $(tr).attr('data-word');
            var pronounciation = $(tr).attr('data-pronounciation');
            var phrase = $(tr).attr('data-phrase');
            var hint = $(tr).attr('data-hint');
            var definition = $(tr).attr('data-definition');
            $('#div-databaseword').html(word);
            $('#div-Pronounced').html(pronounciation);
            $('#div-Phrase').html(phrase);
            $('#div-Hint').html(hint);
            $('#div-Definition').html(definition);
        }


    });
    var wordList = [];




    $(document).on('click', '.ckb-word-item', function () {
        var wordId = $(this).attr('data-wordid');
        if ($(this).prop("checked") == true) {
            wordList.push(wordId);
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) + parseInt(1)));
        }
        else {
            wordList.splice($.inArray(wordId, wordList), 1);
            $('#selected-item-count').text(" " + parseInt(parseInt($('#selected-item-count').text()) - parseInt(1)));
        }
        console.log(wordList);
    });


</script>

<script>

    $(document).on('click', '.word-delete', function () {
        var source = $(this);
        var wordId = $(this).attr('data-wordid');
        //url: '/Sharing/deletWordSharedWithMeWords?wordId=' + wordId,
        swal({
            title: "Are you sure?",
            text: "Your will not be able to recover this file!",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, delete it!",
            closeOnConfirm: false
        },
            function () {
                $.ajax({
                    url: '/QuesterSharing/Quester_deletWordSharedWithMeWords?wordId=' + wordId,
                    type: "GET",
                    dataType: 'JSON',
                    success: function (data) {
                        if (data == 1) {
                            //toastrSuccess("Deleted successfully");
                            swal("Deleted!", "Your file has been deleted.", "success");

                        }
                        else {
                            toastrError("Failed");
                        }
                        location.reload();
                    }
                });

            });
    });


    $(document).on('click', '#delete-selected-words', function () {
        var cbkStatus = false;
        var wordIds = "";
        var count = 0;
        $(document).find('.ckb-word-item').each(function (index, value) {
            if ($(this).prop("checked") == true) {
                count = count + 1;
                cbkStatus = true;
                if (wordIds == "")
                    wordIds = wordIds + $(this).attr('data-wordid');
                else
                    wordIds = wordIds + "," + $(this).attr('data-wordid');
            }
        });
        if (cbkStatus == false && wordList.length <= 0) {
            toastrError('Please select a word');
        }
        else {
            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, delete it!",
                closeOnConfirm: false
            },
  function () {


      var userId = $('#userId').val();
      var objs = new Object();
      objs.userId = userId;
      objs.wordIds = wordList.join(',')

      $.ajax({
          url: '/QuesterSharing/Quester_deletSelecteSharedWithMe',
          type: "POST",
          data: objs,
          dataType: 'JSON',
          success: function (data) {
              if (data == 1) {
                  //toastrSuccess("Deleted successfully");
                  swal("Deleted!", "Your file has been deleted.", "success");

              }
              else {
                  toastrError("Failed");
              }
              location.reload();
          }
      });

  });
        }
    });


    $(document).on('click', '#delete-all-words', function () {

        if ($('.tr-word-row').length > 0) {

            swal({
                title: "Are you sure?",
                text: "Your will not be able to recover this file!",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes, delete it!",
                closeOnConfirm: false
            },
    function () {
        var userId = $('#userId').val();
        var CreatedOn = $("#CreatedOn").val();
        var objs = new Object();
        objs.userId = userId;
        objs.CreatedOn = CreatedOn;
        $.ajax({
            url: '/QuesterSharing/Quester_deletAllSharedWithMe',
            type: "POST",
            data: objs,
            dataType: 'JSON',
            success: function (data) {
                if (data == 1) {
                    //toastrSuccess("Deleted successfully");
                    swal("Deleted!", "Your file has been deleted.", "success");

                }
                else {
                    toastrError("Failed");
                }
                location.reload();
            }
        });

    });
        }
        else {
            toastrError("No Questions to delete");
        }
    });


</script>


<script>
    $(document).on('click', '#btn-search-word', function () {
        var searchText = $('#ipt-word-search').val();
        searchText = $.trim(searchText);
        var CreatedOn = $("#CreatedOn").val();
        var userId = $('#userId').val();

        var objs = new Object();
        objs.userId = userId;
        objs.searchText = searchText;
        objs.CreatedOn = CreatedOn;
        $.ajax({
            url: '/QuesterSharing/Quester_SharedWithByWordCount',
            type: "POST",
            data: objs,
            dataType: 'JSON',

            success: function (data) {
                $('#totalWordCount').val(data);
                var obj = new Object();
                obj.userId = $('#userId').val();
                obj.totalWordCount = $('#totalWordCount').val();
                obj.index = parseInt($('#hfn-index').val());
                obj.searchText = searchText;
                obj.sortBy = $('#hfn-sortby').val();
                obj.sortOrder = $('#hfn-sortorder').val();
                obj.CreatedOn = $("#CreatedOn").val();
                $.ajax({
                    url: '/QuesterSharing/Quester_refreshUserWordbyList',
                    type: "POST",
                    data: obj,
                    dataType: 'html',
                    success: function (data) {
                        $('#tbody-wordlist').html(data);
                        var tr = $(document).find('.tr-word-row').first();
                        if (tr.length > 0) {
                            var word = $(tr).attr('data-word');
                            var pronounciation = $(tr).attr('data-pronounciation');
                            var phrase = $(tr).attr('data-phrase');
                            var hint = $(tr).attr('data-hint');
                            var definition = $(tr).attr('data-definition');
                            $('#div-databaseword').html(word);
                            $('#div-Pronounced').html(pronounciation);
                            $('#div-Phrase').html(phrase);
                            $('#div-Hint').html(hint);
                            $('#div-Definition').html(definition);
                        }
                        //$('#wordlist-pagination').data("current", page);
                        var obj1 = new Object();
                        obj1.userId = $('#userId').val();
                        obj1.totalWordCount = $('#totalWordCount').val();
                        obj1.index = parseInt(parseInt($('#hfn-index').val()) + 1);
                        obj1.searchText = $('#ipt-word-search').val();
                        obj1.sortBy = $('#hfn-sortby').val();
                        obj1.sortOrder = $('#hfn-sortorder').val();
                        $.ajax({
                            url: '/QuesterSharing/Quester_refreshUserWordListPagination',
                            type: "POST",
                            data: obj1,
                            dataType: 'html',
                            success: function (data) {
                                $('#nav-pagination').html(data);
                                $('#div-page-count').html('<p>Page ' + parseInt(parseInt($('#hfn-index').val()) + 1) + ' of ' + Math.ceil(parseFloat($('#totalWordCount').val()) / parseFloat(10)) + '</p>')
                                //$('#div-page-count').html('<p>Page ' + parseInt(parseInt($('#hfn-index').val()) + 1) + ' of Convert.ToString(Math.Ceiling(Convert.ToDouble(Convert.ToDouble(totalWordCount) / Convert.ToDouble(10))))</p>')
                            }
                        });
                    }
                });
            }
        });
    });
</script>

<script>


    $(document).on('click', '#a-add-word-fav', function () {
        var cbkStatus = false;
        var wordIds = "";
        var count = 0;
        $(document).find('.ckb-word-item').each(function (index, value) {
            if ($(this).prop("checked") == true) {
                count = count + 1;
                cbkStatus = true;
                if (wordIds == "")
