@model TutionCloudWeb.Models.PostModel.OnlineCommunity.WordClass

@{
    ViewBag.Title = "WordListSharedwithMe";
    
    Layout = "~/Views/Shared/_Layout_Quester_Home.cshtml";
    var totalWordCount = Model.totalWordCount;
}

@Html.HiddenFor(z => z.userId, new { Value = Model.userId })
@Html.HiddenFor(z => z.totalWordCount, new { Value = Model.totalWordCount })
<input type="hidden" id="hfn-index" value="0" />
<input type="hidden" id="hfn-sortby" value="" />
<input type="hidden" id="hfn-sortorder" value="" />

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-12 col-sm-12">
                <div class="ShareHead">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            <div class="my-share">
                                <h6>Question Lists Shared with Me</h6>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12">
                            
                        </div>
                    </div>
                </div>
                <div class="ShareTab">
                    <div class="with-me new-kp">
                        <table class="table table-hover newTable table-bordered">
                                                          
                            <thead>
                            @*<th class="tabhead">Select</th>*@
                            <th class="tabhead"> Date & Time of Tests</th>
                            <th class="tabhead">Options</th>
                            </thead>
                            <tbody id="tbody-wordlist">
                                @{
                                    var postModel = new TutionCloudWeb.Models.PostModel.OnlineCommunity.WordList();
                                    postModel.userId = Model.userId;
                                    postModel.index = 0;
                                    postModel.totalWordCount = totalWordCount;
                                    postModel.searchText = string.Empty;
                                    postModel.sortBy = string.Empty;
                                    postModel.sortOrder = string.Empty;
                                    postModel.wordIds = "";
                                }
                                @Html.Partial("~/Views/QuesterSharing/_pv_Quester_Sharing_WordListSharedwithMe.cshtml", postModel)
                            </tbody>
                        </table>

                        <div class="Indctor" id="div-page-count">
                            <p>Page 1 of @Convert.ToString(Math.Ceiling(Convert.ToDouble(Convert.ToDouble(totalWordCount) / Convert.ToDouble(10))))</p>
                        </div>
                        <div class="Pgntation">
                            <nav aria-label="Page navigation example" id="nav-pagination">
                                @{
                                    var postModelPagination = new TutionCloudWeb.Models.PostModel.OnlineCommunity.WordList();
                                    postModelPagination.userId = Model.userId;
                                    postModelPagination.index = 1;
                                    postModelPagination.totalWordCount = totalWordCount;
                                    postModelPagination.searchText = string.Empty;
                                    postModelPagination.sortBy = string.Empty;
                                    postModelPagination.sortOrder = string.Empty;
                                }
                                @Html.Partial("~/Views/QuesterSharing/_pv_Quester_Sharing_Word_List_Pagination.cshtml", postModelPagination)
                            </nav>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-12 col-sm-12">
                <div class="newdrpn share-with-me_drpn">
                    <div class="dropdown">
                        <button type="button" class="btn btn-primary " data-toggle="dropdown">Task Dropdown List <img src="~/Content/img/BotumArrow.png" /></button>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" onclick="history.back()">Back</a>
                            <a class="dropdown-item" id="a_DeleteAll">Delete All</a>
                        </div>
                    </div>
                </div>
                <div class="wraper ">
                    <div class="ShareForm wraper share-with-me">
                        <form>
                            <div class="form-group wraper">
                                <label class="checkbox-inline Label">
                                    * Enter Password to View this Question List
                                </label>
                            </div>
                            <div class="form-group wraper">
                                <input type="text" id="txt_Password" class="form-control Input">
                                <label for="password" class="Inputlabel">Password</label>
                            </div>
                            <div class="form-group wraper">
                                <input type="text" class="form-control Input" id="txt_TestID">
                                <label class="Inputlabel">List ID</label>
                            </div>
                            <div class="form-group wraper">
                                <input type="text" class="form-control Input" id="txt_WordListName">
                                <label class="Inputlabel">Question List Name</label>
                            </div>
                            <div class="form-group wraper Send">
                                <div class="Srchbx">
                                    <input type="button" class="button_blue" id="btn_Activate" value="RETRIEVE" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="lowerNav">
            <nav class="navbar navbar-expand-sm  justify-content-center">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a href="https://en.wikipedia.org/wiki/Main.page" target="_blank">Wikipedia</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.google.com/search?q=calculator" target="_blank">Calculator</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.google.com/maps/" target="_blank">Maps</a>
                    </li>
                    <li class="nav-item">
                        <a href="http://www.xe.com/currencyconverter/" target="_blank">Currency Converter</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://www.timeanddate.com/worldclock/full.html" target="_blank">World Clocks</a>
                    </li>
                    <li class="nav-item">
                        <a href="https://translate.google.com" target="_blank">Translator</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</section>

<script>
    //Retrieveddatas();
    //function Retrieveddatas() {
    //    alert(public_CreatedOn);
    //}

    $("#a_ClickSharing").css({ "color": "#98aaff" });
    
    $("#btn_Activate").click(function () {
        debugger;
        var Password = $("#txt_Password").val();
        var TestId = $("#txt_TestID").val();
        var LastName = $("#txt_WordListName").val();
        var userId = $("#userId").val();

        if (TestId == "" || LastName == "") {
            swal("Warning!", "Please enter the details in the fields for Retrieval")
        }
        else {
            var obj = new Object();

            obj.Password = Password;
            obj.TestId = TestId;
            obj.LastName = LastName;
            obj.userId = userId;

            $.ajax({
                url: '/QuesterSharing/Quester_ShareActivateCheck',
                type: "POST",
                data: obj,
                dataType: 'JSON',
                success: function (data) {
                    //alert(data.datestring + " = 09/05/2019 11:50 AM");
                    public_CreatedOn = data.datestring;
                    if (public_CreatedOn != null) {
                        if (public_CreatedOn == 0) {
                            swal("Warning!", "The Shared List details you have entered are incorrect. Please try again.")

                        }
                        else {
                            $('td[pointe-evend-enable="' + public_CreatedOn + '"]').css({
                                'pointer-events': 'auto',
                                'color': 'red',
                                'font-weight': 'bold'

                            });
                            $('strong[pointe-evend-enable-strong="' + public_CreatedOn + '"]').css({
                                'pointer-events': 'auto',
                                'color': 'red',
                                'font-weight': 'bold'
                            });
                            $('a[pointe-evend-enable-A="' + public_CreatedOn + '"]').css({
                                'pointer-events': 'auto',
                                'color': 'red',
                                'font-weight': 'bold'
                            });
                            swal("Retrieval of this Question List was successful.", "Please now click on " + public_CreatedOn + " and VIEW link to see your shared Question List.", "success")

                        }

                    }


                }
            });

        }
    });

    $("#a_DeleteAll").click(function () {
        var userId = $("#userId").val();
        swal({
            title: "Are you sure?",
            text: "Your will not be able to recover this imaginary all files!",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btn-danger",
            confirmButtonText: "Yes, delete it!",
            closeOnConfirm: false
        },
        function () {

            $.ajax({
                url: '/QuesterSharing/Quester_DeleteALLWordListSharedwithMe?userId=' + userId,
                type: "GET",
                dataType: 'JSON',
                success: function (data) {
                    if (data == 1) {
                        //toastrSuccess("Deleted successfully");
                        swal("Deleted!", "Your all file has been deleted.", "success");

                    }
                    else {
                        toastrError("Failed");
                    }
                    location.reload();
                }
            });

            
        });

    });
   
</script>
